name: CI

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Download code
        uses: actions/checkout@v4

      - name: Install Java
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '8'

      - name: Run tests
        run: mvn -B test

      - name: Build with Maven
        run: mvn -B clean package

      - name: Save the WAR file
        uses: actions/upload-artifact@v4
        with:
          name: app-war
          path: target/*.war

      - name: Log in to GitHub registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push Docker image
        run: |
          docker build -t ghcr.io/vaishnaviagarwal-29/build-demo:latest .
          docker push ghcr.io/vaishnaviagarwal-29/build-demo:latest
