name: CI

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Download code
        uses: actions/checkout@v4

      - name: Install Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Build with Maven
        run: mvn -B clean package

      - name: Save the WAR file
        uses: actions/upload-artifact@v4
        with:
          name: app-war
          path: target/*.war






  notify:
    needs: [build, deploy]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: Send Pipeline Status Email
        uses: dawidd6/action-send-mail@v3.1.2@sha256:d541097e366304b407425f190e3860bb391307b0c36b856230f2f4c9c869e5d4 # Pinning or using exact hash if required, or update tag/hash below
